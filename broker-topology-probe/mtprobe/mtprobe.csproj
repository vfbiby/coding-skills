<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <MtapiDir Condition="'$(MtapiDir)' == ''">$(MSBuildThisFileDirectory)../../../../mtapi</MtapiDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MT4ServerAPI"><HintPath>$(MtapiDir)/MT4ServerAPI.dll</HintPath></Reference>
    <Reference Include="mt5api"><HintPath>$(MtapiDir)/mt5api.dll</HintPath></Reference>
  </ItemGroup>
</Project>
